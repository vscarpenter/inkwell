{
  "_meta": {
    "name": "Inkwell",
    "palette": "Indigo & Cloud",
    "version": "3.0.0",
    "canonical_source": "inkwell-tokens.css",
    "note": "Generated by scripts/build-tokens-json.mjs from inkwell-tokens.css. Do not edit by hand — re-run the script when CSS tokens change. Values are resolved from the single-declaration light-dark()/color-mix() cascade."
  },
  "color": {
    "surface": {
      "ivory": { "light": "#F4F4F0", "dark": "#0F1018", "role": "Page background" },
      "paper": { "light": "#FFFFFF", "dark": "#181A24", "role": "Card / panel surface" },
      "slate": { "light": "#13141B", "dark": "#E8E8EE", "role": "Primary text" },
      "oat": { "light": "#DDDCDF", "dark": "#2B2D38", "role": "Tertiary surface, hover thumbnails" }
    },
    "accent": {
      "accent": { "light": "#3B4A8C", "dark": "#7A8AD1", "role": "Links, focus, active state" },
      "accent_d": { "light": "#2A3768", "dark": "#8B9ADB", "role": "Hover/pressed accent" },
      "accent_tint": { "light": "rgba(59, 74, 140, 0.14)", "dark": "rgba(122, 138, 209, 0.1)", "role": "Badge background" },
      "accent_focus_ring": { "light": "rgba(59, 74, 140, 0.18)", "dark": "rgba(122, 138, 209, 0.28)", "role": "Input focus halo" },
      "accent_strong_border": { "light": "rgba(59, 74, 140, 0.5)", "dark": "rgba(122, 138, 209, 0.6)", "role": "Tinted chip border" },
      "accent_ink": {
        "light": "var(--accent)",
        "dark": "var(--accent)",
        "role": "Accent as text/outline (links, tabs, badge text, focus ring)"
      },
      "on_accent": { "light": "var(--paper)", "dark": "var(--paper)", "role": "Label color on accent fills" }
    },
    "semantic": {
      "olive": { "light": "#788C5D", "dark": "#9CB07A", "role": "Success, additions" },
      "olive_tint": { "light": "rgba(120, 140, 93, 0.16)", "dark": "rgba(156, 176, 122, 0.18)", "role": "Success badge background" },
      "olive_strong_border": {
        "light": "rgba(120, 140, 93, 0.45)",
        "dark": "rgba(156, 176, 122, 0.6)",
        "role": "Tinted success border (chip-dot.safe, alert.is-success)"
      },
      "olive_dark": {
        "light": "#566740",
        "dark": "#9CB07A",
        "role": "Olive as text/solid fill (badge-success, stat-delta.up, pill.resolved)"
      },
      "rust": { "light": "#B04A3F", "dark": "#D27468", "role": "Danger, deletions, errors" },
      "rust_d": { "light": "#9A3F3F", "dark": "#C96B5F", "role": "Rust hover/pressed state" },
      "rust_tint": { "light": "rgba(176, 74, 63, 0.1)", "dark": "rgba(210, 116, 104, 0.18)", "role": "Danger alert background" },
      "rust_tint_border": { "light": "rgba(176, 74, 63, 0.45)", "dark": "rgba(210, 116, 104, 0.6)", "role": "Danger alert border" },
      "rust_focus_ring": {
        "light": "rgba(176, 74, 63, 0.18)",
        "dark": "rgba(210, 116, 104, 0.28)",
        "role": "Danger input focus halo (is-error)"
      },
      "warning": { "light": "#C78E3F", "dark": "#D9A55F", "role": "Amber warning" },
      "warning_dark": { "light": "#85561E", "dark": "#D9A55F", "role": "Warning text (darker for contrast)" },
      "warning_tint": { "light": "rgba(199, 142, 63, 0.16)", "dark": "rgba(217, 165, 95, 0.18)", "role": "Warning badge background" },
      "warning_strong_border": {
        "light": "rgba(199, 142, 63, 0.45)",
        "dark": "rgba(217, 165, 95, 0.6)",
        "role": "Tinted warning border (alert.is-warning)"
      },
      "info": { "light": "#5C7CA3", "dark": "#7C9FD2", "role": "Informational" },
      "sky": { "light": "#6A8CAF", "dark": "#85A6CB", "role": "Alt info / second data-viz hue" },
      "info_tint": { "light": "rgba(92, 124, 163, 0.16)", "dark": "rgba(124, 159, 210, 0.18)", "role": "Info alert background" },
      "info_strong_border": { "light": "rgba(92, 124, 163, 0.45)", "dark": "rgba(124, 159, 210, 0.6)", "role": "Info alert border" }
    },
    "neutral": {
      "gray_100": { "light": "#EDEDEA", "dark": "#1E1F29", "role": "Subtle row stripe, code-chip bg" },
      "gray_200": { "light": "#E1E1DE", "dark": "#262732", "role": "Divider on white" },
      "gray_300": { "light": "#CFCFCC", "dark": "#34363F", "role": "Default 1.5px border" },
      "gray_400": { "light": "#88888E", "dark": "#666874", "role": "Control boundaries (checkbox/radio/switch) — WCAG 1.4.11" },
      "gray_500": { "light": "#6F6F75", "dark": "#9A9AA0", "role": "Muted text, captions (WCAG AA)" },
      "gray_700": { "light": "#3A3B41", "dark": "#C0C0C7", "role": "Secondary body text" }
    }
  },
  "typography": {
    "family": {
      "serif": "\"Iowan Old Style\", \"Palatino\", \"Palatino Linotype\", \"Source Serif Pro\", Georgia, serif",
      "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Monaco, Consolas, monospace"
    },
    "size": {
      "display": { "px": 48, "role": "Hero numerals & largest serif headlines" },
      "h1": { "px": 32, "role": "Page-level serif heading" },
      "h2": { "px": 24, "role": "Section serif heading" },
      "h3": { "px": 19, "role": "Card / sub-section serif heading" },
      "lede": { "px": 20, "role": "Deck/intro paragraph — serif italic, magazine archetype" },
      "body": { "px": 16, "role": "Default body sans" },
      "small": { "px": 14, "role": "Secondary copy / captions" },
      "caption": { "px": 12, "role": "Caption sans" },
      "eyebrow": { "px": 11, "role": "Uppercase mono lead-in" }
    }
  },
  "spacing": {
    "sp_1": "4px",
    "sp_2": "8px",
    "sp_3": "12px",
    "sp_4": "16px",
    "sp_5": "24px",
    "sp_6": "32px",
    "sp_7": "48px",
    "sp_8": "64px",
    "_note": "8px base with 4px micro step. Card padding 18-24px; section gaps 48-72px."
  },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "14px", "xl": "20px", "pill": "999px" },
  "border": {
    "default": "1.5px solid var(--gray-300)",
    "strong": "1.5px solid var(--slate)",
    "hair": "1px solid var(--gray-100)",
    "rule": "1px solid var(--gray-300)",
    "control": "1.5px solid var(--gray-400)",
    "_note": "1.5px is the system signature — do not substitute 1px or 2px on outer panels."
  },
  "shadow": {
    "sm": { "light": "0 1px 2px rgba(20, 20, 19, 0.06)", "dark": "0 1px 2px rgba(0, 0, 0, 0.45)" },
    "md": { "light": "0 4px 14px rgba(20, 20, 19, 0.08)", "dark": "0 4px 14px rgba(0, 0, 0, 0.50)" },
    "lg": { "light": "0 12px 28px rgba(20, 20, 19, 0.12)", "dark": "0 12px 28px rgba(0, 0, 0, 0.55)" },
    "card_hover": { "light": "0 10px 30px rgba(20, 20, 19, 0.10)", "dark": "0 10px 30px rgba(0, 0, 0, 0.50)" }
  },
  "backdrop": {
    "default": { "light": "rgba(15, 16, 24, 0.55)", "dark": "rgba(0, 0, 0, 0.6)", "role": "dialog::backdrop, modal scrims" }
  },
  "tldr_code_tint": {
    "default": {
      "light": "rgba(255, 255, 255, 0.08)",
      "dark": "rgba(0, 0, 0, 0.08)",
      "role": ".tldr code-chip overlay — inverts with the .tldr surface"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "150ms",
    "slow": "300ms",
    "ease_out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease_pop": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "layout": { "content_narrow": "820px", "content_default": "920px", "content_wide": "1120px", "page_pad_x": "24px" },
  "z_index": { "base": 1, "raised": 10, "sticky": 20, "overlay": 30, "modal": 50 }
}
